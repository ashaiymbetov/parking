# Local development outside Docker (copy to .env).
# Matches the postgres service from docker-compose.yml (published on 5433).
DATABASE_URL=postgres://parking:parking@localhost:5433/parking
PORT=3000
WORKER_POLL_MS=5000
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_TTL_SECONDS=43200
EARLY_ENTRY_MIN=15
# Mailpit from docker-compose (web UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
